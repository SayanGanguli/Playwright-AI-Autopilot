{
  "compilerOptions": {
    "target": "ESNext",
    "module": "node16",
    "moduleResolution": "node16",
    "types": [
      "node",
      "@playwright/test"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@pages/*": [
        "./src/pages/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@fixtures/*": [
        "./src/fixtures/*"
      ],
      "@test-data/*": [
        "./src/test-data/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "mcp/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report"
  ]
}